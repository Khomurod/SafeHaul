{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "safehaul-e2e-dev",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "set VITE_E2E_TEST_MODE=1&& npm run dev"],
      "port": 5000
    },
    {
      "name": "safehaul-landing",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["vite", "landing", "--port", "4173", "--strictPort"],
      "port": 4173
    },
    {
      "name": "proto-a-throughline",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["vite", "--config", "landing-prototypes/vite.config.js", "--port", "4181", "--strictPort"],
      "port": 4181,
      "url": "http://localhost:4181"
    },
    {
      "name": "proto-b-quiet-authority",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["vite", "--config", "landing-prototypes/vite.config.js", "--port", "4182", "--strictPort"],
      "port": 4182,
      "url": "http://localhost:4182"
    },
    {
      "name": "proto-c-continuum",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["vite", "--config", "landing-prototypes/vite.config.js", "--port", "4183", "--strictPort"],
      "port": 4183,
      "url": "http://localhost:4183"
    }
  ]
}
