{
  "name": "hr-final",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node -e \"const fs=require('fs');fs.copyFileSync('node_modules/pdfjs-dist/build/pdf.worker.min.mjs','public/pdf.worker.min.mjs');console.log('✅ PDF worker synced from node_modules')\"",
    "build": "vite build",
    "lint": "npm run lint:frontend && npm run lint:backend",
    "lint:frontend": "eslint .",
    "lint:backend": "cd functions && npm run lint",
    "preview": "vite preview",
    "test": "vitest",
    "test:rules": "vitest --run src/tests/firestore.rules.security.test.js src/tests/storage.rules.security.test.js",
    "test:rules:emulators": "node scripts/run-rules-stress.mjs --loops=1",
    "test:rules:stress": "node scripts/run-rules-stress.mjs",
    "test:e2e": "playwright test",
    "deploy:functions": "firebase deploy --only functions --non-interactive",
    "deploy:functions:sequential": "node scripts/deploy-functions-sequential.mjs",
    "deploy:functions:incremental": "node scripts/deploy-functions-incremental.mjs",
    "check:function-exports": "node scripts/validate-function-index-parse.mjs",
    "check:deploy-script": "node scripts/test-deploy-incremental.mjs",
    "deploy:functions:plan": "node scripts/deploy-functions-incremental.mjs --dry-run",
    "storage:set-cors": "node scripts/set-storage-cors.mjs",
    "typecheck": "tsc -p jsconfig.json --noEmit",
    "test:coverage": "vitest run --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:stories": "vitest run src/tests/designSystemStories.a11y.test.jsx"
  },
  "dependencies": {
    "@sentry/react": "^10.32.1",
    "canvas-confetti": "^1.9.4",
    "dompurify": "^3.4.2",
    "exceljs": "^4.4.0",
    "firebase": "^11.0.2",
    "jspdf": "^4.0.0",
    "lucide-react": "^0.552.0",
    "papaparse": "^5.5.3",
    "pdfjs-dist": "5.4.296",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-draggable": "^4.5.0",
    "react-pdf": "^10.2.0",
    "react-router-dom": "^7.18.1",
    "react-signature-canvas": "1.1.0-alpha.2",
    "react-virtuoso": "^4.18.1",
    "recharts": "^3.6.0",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^9.36.0",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@playwright/test": "^1.57.0",
    "@storybook/addon-a11y": "^10.5.5",
    "@storybook/addon-docs": "^10.5.5",
    "@storybook/react-vite": "^10.5.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^4.0.17",
    "autoprefixer": "^10.4.21",
    "baseline-browser-mapping": "^2.9.14",
    "eslint": "^9.36.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "fake-indexeddb": "^6.2.5",
    "firebase-tools": "^15.3.1",
    "globals": "^16.4.0",
    "happy-dom": "^20.0.11",
    "playwright": "^1.59.1",
    "postcss": "^8.5.6",
    "storybook": "^10.5.5",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "vitest": "^4.0.14",
    "vitest-axe": "^0.1.0"
  }
}
