# Required for bulk campaigns (initBulkSession + processBulkBatch). Same values on both functions.
BULK_WORKER_SECRET=replace-with-strong-random-secret-min-16-chars
PROCESS_BULK_BATCH_URL=https://processbulkbatch-xxxxx-uc.a.run.app
GROQ_API_KEY=replace-with-groq-api-key
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# AI Field Assistant (analyzeEdocFieldPlacement). Separate pin from the CDL
# parser above so document analysis and CDL OCR can move independently.
# Must be a vision model that also supports json_schema structured outputs.
GROQ_DOCUMENT_VISION_MODEL=meta-llama/llama-4-maverick-17b-128e-instruct

# Telegram Bot (optional until configured)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Copy this file to `functions/.env` for local Functions / emulator (never commit real secrets).
# Root `.env.local` is for Vite only; Functions read `functions/.env` when present.
