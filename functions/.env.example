# Required for bulk campaigns (initBulkSession + processBulkBatch). Same values on both functions.
BULK_WORKER_SECRET=replace-with-strong-random-secret-min-16-chars
PROCESS_BULK_BATCH_URL=https://processbulkbatch-xxxxx-uc.a.run.app

# Legacy Groq binding, kept as the rollback path during the AI credential
# migration. The shared AI platform reads it only when the managed credential
# SAFEHAUL_AI_GROQ_APIKEY is absent. See docs/ai-platform.md.
GROQ_API_KEY=replace-with-groq-api-key

# AI provider credentials are NOT configured here. They live in Google Secret
# Manager under SAFEHAUL_AI_<PROVIDER>_<FIELD> and are managed from
# Super Admin -> AI Integrations. Model pins and provider selection are
# declared in functions/ai/registry/providers.js, not as environment
# variables, so adding a provider needs no redeploy.

# Landing-page Telegram delivery is configured in Google Secret Manager, not
# in this file: LANDING_TELEGRAM_BOT_TOKEN and LANDING_TELEGRAM_CHAT_ID.

# Copy this file to `functions/.env` for local Functions / emulator (never commit real secrets).
# Root `.env.local` is for Vite only; Functions read `functions/.env` when present.
