        { "name": "employment: block with 12 of 36 months", "rules": { "employmentHistoryEnforcement": "block" }, "formData": { "employers": [{ "companyName": "Acme", "startDate": "2025-10", "endDate": "" }] }, "blocking": ["employment-coverage"], "warnings": [] },
        { "name": "employment: allow never mentions coverage", "rules": { "employmentHistoryEnforcement": "allow" }, "formData": {}, "blocking": [], "warnings": [] },
        { "name": "employment: a 1-year minimum is satisfied by 12 months", "rules": { "employmentHistoryEnforcement": "block", "employmentHistoryMinimumYears": 1 }, "formData": { "employers": [{ "companyName": "Acme", "startDate": "2025-10", "endDate": "" }] }, "blocking": [], "warnings": [] },
