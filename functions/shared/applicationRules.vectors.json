        { "name": "violations: rule on, Yes with a complete row passes", "rules": { "requireViolationDetails": true }, "formData": { "has-violations": "yes", "violations": [{ "date": "2025-03-01", "charge": "Speeding", "location": "Dallas, TX" }], "employers": "$fullHistory" }, "blocking": [], "warnings": [] },
        { "name": "violations: legacy rows with no answer count as Yes", "rules": { "requireViolationDetails": true }, "formData": { "violations": [{ "date": "2025-03-01", "charge": "Speeding", "location": "Dallas, TX" }], "employers": "$fullHistory" }, "blocking": [], "warnings": [] },
