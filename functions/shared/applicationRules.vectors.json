        { "name": "previous address: rule on, an incomplete row does not count", "rules": { "requirePreviousAddressUnderThreeYears": true }, "formData": { "residence-3-years": "no", "previousAddresses": [{ "street": "1 Old St", "city": "Town", "state": "TX", "zip": "", "startDate": "2023-01", "endDate": "2024-01" }], "employers": "$fullHistory" }, "blocking": ["previous-address-required"], "warnings": [] },
        { "name": "previous address: rule on, a complete row passes", "rules": { "requirePreviousAddressUnderThreeYears": true }, "formData": { "residence-3-years": "no", "previousAddresses": [{ "street": "1 Old St", "city": "Town", "state": "TX", "zip": "75001", "startDate": "2023-01", "endDate": "2024-01" }], "employers": "$fullHistory" }, "blocking": [], "warnings": [] },
        { "name": "previous address: rule on but Yes to 3 years passes", "rules": { "requirePreviousAddressUnderThreeYears": true }, "formData": { "residence-3-years": "yes", "employers": "$fullHistory" }, "blocking": [], "warnings": [] },
        { "name": "previous address: hidden address history is never enforced", "rules": { "requirePreviousAddressUnderThreeYears": true }, "applicationConfig": { "addressHistory": { "hidden": true } }, "formData": { "residence-3-years": "no", "employers": "$fullHistory" }, "blocking": [], "warnings": [] },
        { "name": "experience: Student / Recent Grad offered by default", "rules": {}, "formData": { "experience-years": "New", "employers": "$fullHistory" }, "blocking": [], "warnings": [] },
        { "name": "experience: a hidden option is refused", "rules": { "experienceOptionsHidden": ["New"] }, "formData": { "experience-years": "New", "employers": "$fullHistory" }, "blocking": ["experience-option-not-offered"], "warnings": [] },
