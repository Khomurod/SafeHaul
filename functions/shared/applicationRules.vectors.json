        { "name": "expired CDL blocks when the company says block", "rules": { "expiredCdl": "block" }, "formData": { "cdlExpiration": "2020-01-01", "employers": "$fullHistory" }, "blocking": ["expired-cdlExpiration"], "warnings": [] },
        { "name": "a CDL that expires today is current", "rules": { "expiredCdl": "block" }, "formData": { "cdlExpiration": "2026-09-02", "employers": "$fullHistory" }, "blocking": [], "warnings": [] },
        { "name": "expired medical card blocks", "rules": { "expiredMedicalCard": "block" }, "formData": { "medCardExpiration": "2026-08-31", "employers": "$fullHistory" }, "blocking": ["expired-medCardExpiration"], "warnings": [] },
        { "name": "a month-only medical card date covers the whole month", "rules": { "expiredMedicalCard": "block" }, "formData": { "medCardExpiration": "2026-09", "employers": "$fullHistory" }, "blocking": [], "warnings": [] },
        { "name": "hidden medical card question is never enforced", "rules": { "expiredMedicalCard": "block" }, "applicationConfig": { "medCardUpload": { "hidden": true } }, "formData": { "medCardExpiration": "2020-01-01", "employers": "$fullHistory" }, "blocking": [], "warnings": [] },
        { "name": "previous address: rule off, No with no rows passes", "rules": {}, "formData": { "residence-3-years": "no", "employers": "$fullHistory" }, "blocking": [], "warnings": [] },
