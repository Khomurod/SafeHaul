        { "name": "accidents: rule on, every row complete passes", "rules": { "requireAccidentDetails": true }, "formData": { "has-accidents": "yes", "accidents": [{ "date": "2025-03-01", "details": "Rear-ended", "fatalities": "0", "injuries": "1", "hazmatSpill": "no" }], "employers": "$fullHistory" }, "blocking": [], "warnings": [] },
        { "name": "accidents: rule on, No passes", "rules": { "requireAccidentDetails": true }, "formData": { "has-accidents": "no", "employers": "$fullHistory" }, "blocking": [], "warnings": [] },
