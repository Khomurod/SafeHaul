# Dependencies
node_modules/

# Environment & Secrets
# Ignoring local env files does not stop Firebase from reading them
# during local deploys, but it does prevent accidental commits.
.env
.env.local
.env.*
!.env.example
*.local

# Logs
*.log

# DEBT-3 FIX: Test output files should not be committed
jest_output*.txt

# Cache
.cache/
