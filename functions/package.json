    "@ringcentral/sdk": "^5.0.11",
    "axios": "^1.21.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "joi": "^18.3.1",
    "nodemailer": "^10.3.1",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "^10.13.0",
    "eslint-config-google": "^0.14.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2"
  },
  "jest": {
    "moduleNameMapper": {
      "^jose$": "<rootDir>/test/helpers/joseStandIn.js"
    }
