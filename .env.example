VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id

# --- Client vs server ---
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# Never put private API keys, worker secrets, or Groq keys in VITE_* variables.

# Employer dashboard: read pre-aggregated KPI counts from Firestore when
# `companies/{id}/internal_stats/dashboard` exists (maintained by Cloud Functions).
# Set to "false" to always use on-demand aggregate queries (rollback / debugging).
# VITE_USE_DASHBOARD_SUMMARY=false

# FMCSA employer autocomplete (Transportation.gov / Socrata — public app token, rate limits)
VITE_SOCRATA_APP_TOKEN=

# Facebook Lead Ads Integration
VITE_FACEBOOK_APP_ID=your-facebook-app-id

# Sentry Error Monitoring
VITE_SENTRY_DSN=https://your-public-key@o0.ingest.sentry.io/0

# Backend Configuration (Cloud Functions V2)
PROCESS_BULK_BATCH_URL=https://your-cloud-run-url.a.run.app

# Primary auth should be Firebase Custom Claims (globalRole = 'super_admin').
VITE_SUPER_ADMIN_EMAIL=admin@your-company.com
