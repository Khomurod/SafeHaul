{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "firestore": {
    "rules": "src/firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": [
    {
      "target": "testing",
      "public": "dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "X-Frame-Options",
              "value": "SAMEORIGIN"
            },
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "Content-Security-Policy",
              "value": "frame-ancestors 'self'"
            },
            {
              "key": "Content-Security-Policy-Report-Only",
              "value": "default-src 'self'; script-src 'self' https://connect.facebook.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' blob: https://firestore.googleapis.com https://www.google.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://firebasestorage.googleapis.com https://storage.googleapis.com https://us-central1-truckerapp-system.cloudfunctions.net https://*.ingest.sentry.io https://*.ingest.us.sentry.io https://graph.facebook.com https://www.facebook.com https://docs.google.com https://*.googleusercontent.com https://data.transportation.gov; frame-src 'self' blob: https://firebasestorage.googleapis.com https://storage.googleapis.com https://www.facebook.com https://web.facebook.com https://staticxx.facebook.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'"
            }
          ]
        },
        {
          "source": "/assets/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "target": "production",
      "public": "dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "X-Frame-Options",
              "value": "SAMEORIGIN"
            },
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "Content-Security-Policy",
              "value": "frame-ancestors 'self'"
            },
            {
              "key": "Content-Security-Policy-Report-Only",
              "value": "default-src 'self'; script-src 'self' https://connect.facebook.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' blob: https://firestore.googleapis.com https://www.google.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://firebasestorage.googleapis.com https://storage.googleapis.com https://us-central1-truckerapp-system.cloudfunctions.net https://*.ingest.sentry.io https://*.ingest.us.sentry.io https://graph.facebook.com https://www.facebook.com https://docs.google.com https://*.googleusercontent.com https://data.transportation.gov; frame-src 'self' blob: https://firebasestorage.googleapis.com https://storage.googleapis.com https://www.facebook.com https://web.facebook.com https://staticxx.facebook.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'"
            }
          ]
        },
        {
          "source": "/assets/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "target": "landing-testing",
      "public": "web",
      "ignore": [
        "firebase.json",
        "**/.*"
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "X-Frame-Options",
              "value": "DENY"
            },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            },
            {
              "key": "Permissions-Policy",
              "value": "camera=(), microphone=(), geolocation=()"
            },
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "/news",
          "function": {
            "functionId": "serveBlogPublic",
            "region": "us-central1"
          }
        },
        {
          "source": "/news/**",
          "function": {
            "functionId": "serveBlogPublic",
            "region": "us-central1"
          }
        },
        {
          "source": "/api/news/**",
          "function": {
            "functionId": "serveBlogPublic",
            "region": "us-central1"
          }
        },
        {
          "source": "/sitemap.xml",
          "function": {
            "functionId": "serveBlogPublic",
            "region": "us-central1"
          }
        }
      ],
      "redirects": [
        {
          "source": "/",
          "destination": "/news",
          "type": 302
        }
      ]
    },
    {
      "target": "landing-production",
      "public": "web",
      "ignore": [
        "firebase.json",
        "**/.*"
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "X-Frame-Options",
              "value": "DENY"
            },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            },
            {
              "key": "Permissions-Policy",
              "value": "camera=(), microphone=(), geolocation=()"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "/news",
          "function": {
            "functionId": "serveBlogPublic",
            "region": "us-central1"
          }
        },
        {
          "source": "/news/**",
          "function": {
            "functionId": "serveBlogPublic",
            "region": "us-central1"
          }
        },
        {
          "source": "/api/news/**",
          "function": {
            "functionId": "serveBlogPublic",
            "region": "us-central1"
          }
        },
        {
          "source": "/sitemap.xml",
          "function": {
            "functionId": "serveBlogPublic",
            "region": "us-central1"
          }
        }
      ],
      "redirects": [
        {
          "source": "/",
          "destination": "/news",
          "type": 302
        }
      ]
    }
  ],
  "storage": {
    "rules": "src/storage.rules"
  }
}
