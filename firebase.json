{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "firestore": {
    "rules": "src/firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": [
    {
      "target": "testing",
      "public": "dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "target": "production",
      "public": "dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "target": "landing-testing",
      "public": "web",
      "ignore": [
        "firebase.json",
        "**/.*"
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "X-Frame-Options",
              "value": "DENY"
            },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            },
            {
              "key": "Permissions-Policy",
              "value": "camera=(), microphone=(), geolocation=()"
            },
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "/news",
          "function": {
            "functionId": "serveBlogPublic",
            "region": "us-central1"
          }
        },
        {
          "source": "/news/**",
          "function": {
            "functionId": "serveBlogPublic",
            "region": "us-central1"
          }
        },
        {
          "source": "/api/news/**",
          "function": {
            "functionId": "serveBlogPublic",
            "region": "us-central1"
          }
        },
        {
          "source": "/sitemap.xml",
          "function": {
            "functionId": "serveBlogPublic",
            "region": "us-central1"
          }
        }
      ],
      "redirects": [
        {
          "source": "/",
          "destination": "/news",
          "type": 302
        }
      ]
    },
    {
      "target": "landing-production",
      "public": "web",
      "ignore": [
        "firebase.json",
        "**/.*"
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "X-Frame-Options",
              "value": "DENY"
            },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            },
            {
              "key": "Permissions-Policy",
              "value": "camera=(), microphone=(), geolocation=()"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "/news",
          "function": {
            "functionId": "serveBlogPublic",
            "region": "us-central1"
          }
        },
        {
          "source": "/news/**",
          "function": {
            "functionId": "serveBlogPublic",
            "region": "us-central1"
          }
        },
        {
          "source": "/api/news/**",
          "function": {
            "functionId": "serveBlogPublic",
            "region": "us-central1"
          }
        },
        {
          "source": "/sitemap.xml",
          "function": {
            "functionId": "serveBlogPublic",
            "region": "us-central1"
          }
        }
      ],
      "redirects": [
        {
          "source": "/",
          "destination": "/news",
          "type": 302
        }
      ]
    }
  ],
  "storage": {
    "rules": "src/storage.rules"
  }
}
